# Copy to backend/.env and adjust.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
# Only needed if the Vue app is hosted on a different domain:
CORS_ALLOWED_ORIGINS=

# Database: sqlite (default) or mysql
DB_ENGINE=mysql
DB_NAME=yourname$chayabari
DB_USER=yourname
DB_PASSWORD=your-mysql-password
DB_HOST=yourname.mysql.pythonanywhere-services.com

# Business settings
TRIAL_DAYS=14
TRIAL_MAX_MEMBERS=40
PAY_BKASH_NUMBER=01XXXXXXXXX
PAY_NAGAD_NUMBER=01XXXXXXXXX
PAYMENT_AUTO_VERIFY=False
AUCTION_EXTENSION_MINUTES=2
